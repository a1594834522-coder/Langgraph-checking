# 环境配置示例文件
# 复制为 .env 并填入实际配置值

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 应用配置
APP_NAME=职称评审材料审核系统
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# 文件存储配置
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp
OUTPUT_DIR=./data/outputs
MAX_FILE_SIZE=104857600  # 100MB

# 数据库配置
DATABASE_URL=sqlite:///./data/audit_system.db

# Redis配置（用于任务队列）
REDIS_URL=redis://localhost:6379/0

# API服务配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# AI处理配置
MAX_CONCURRENT_TASKS=10
PDF_MAX_PAGES=100
CHUNK_SIZE=2048
OVERLAP_SIZE=200

# 规则校验配置
ENABLE_STRICT_MODE=True
AUTO_RETRY_COUNT=3
VALIDATION_TIMEOUT=300

# 报告生成配置
REPORT_TEMPLATE_DIR=./templates
REPORT_ASSETS_DIR=./assets
ENABLE_PDF_EXPORT=True

# 安全配置
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 监控配置
ENABLE_METRICS=True
METRICS_PORT=9090

# Marker + Gemma AI配置
# 谷歌AI API配置
GOOGLE_API_KEY=



# Marker配置
MARKER_USE_LLM=true
MARKER_OUTPUT_FORMAT=json
MARKER_FORMAT_LINES=true

# 设备配置
TORCH_DEVICE=cuda

# Hugging Face配置（如果需要）
HF_TOKEN=your_huggingface_token_here

# LangSmith配置（用于调试和监控）
LANGSMITH_API_KEY=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
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=Audit_Workflow_Debug
LANGSMITH_TRACING=true

# LangSmith配置（可选，用于调试和监控）
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=Audit_Workflow_Debug
LANGSMITH_TRACING=true

# Google AI API配置
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash  # 可选值: gemini-1.5-flash, gemini-2.5-flash, gemini-pro

# 应用配置
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Redis配置（用于缓存和任务队列）
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL配置（可选，用于持久化存储）
DATABASE_URL=postgresql://user:password@localhost:5432/langgraph_audit
POSTGRES_USER=langgraph_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=langgraph_audit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 文件处理配置
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=.zip,.md,.txt,.pdf
UPLOAD_DIR=./uploads
EXTRACTED_DIR=./extracted
REPORTS_DIR=./reports

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# 安全配置
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=*
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 工作流配置
WORKFLOW_TIMEOUT=300
MAX_RETRIES=3
CONCURRENT_TASKS=5

# OCR配置
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/4.00/tessdata

# 开发工具配置
LANGCHAIN_VERBOSE=false
LANGCHAIN_DEBUG=false
